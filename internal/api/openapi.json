{
  "openapi": "3.1.0",
  "info": {
    "title": "cobol-api",
    "version": "1.0.0",
    "description": "Moteur d'amortissement de pret ecrit en COBOL, expose en REST.\n\nLes montants sont rendus comme des nombres JSON a deux decimales exactes, produits par une arithmetique decimale a virgule fixe. Ils ne transitent jamais par un flottant binaire.\n\nQuatre invariants sont tenus : la somme des parts de capital egale exactement le capital emprunte, la somme des echeances egale exactement capital plus interets, le solde apres la derniere echeance est exactement nul, et chaque ligne verifie paiement = capital + interets. La derniere echeance absorbe le residu d'arrondi.",
    "license": { "name": "Proprietaire" }
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Developpement local" }],
  "tags": [
    { "name": "credit", "description": "Calculs de credit" },
    { "name": "service", "description": "Etat et description du service" }
  ],
  "security": [{ "cleAPI": [] }],
  "paths": {
    "/": {
      "get": {
        "tags": ["service"],
        "summary": "Index du service",
        "security": [],
        "responses": {
          "200": {
            "description": "Description du service et liste des endpoints",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["service"],
        "summary": "Etat du service",
        "description": "Verifie la presence du binaire COBOL. Le HEALTHCHECK du conteneur s'appuie sur cet endpoint, qui reste ouvert et hors plafond de debit.",
        "security": [],
        "responses": {
          "200": {
            "description": "Service operationnel",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Sante" },
                "example": {
                  "status": "OK",
                  "timestamp": "2026-09-08T21:38:38Z",
                  "programExists": true
                }
              }
            }
          },
          "503": {
            "description": "Binaire COBOL introuvable",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Sante" } }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": ["service"],
        "summary": "Cette specification",
        "security": [],
        "responses": {
          "200": {
            "description": "Document OpenAPI",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/v1/loans/schedule": {
      "get": {
        "tags": ["credit"],
        "summary": "Echeancier de pret",
        "description": "Produit l'echeancier complet et son recapitulatif, TAEG compris. Le TAEG est resolu par dichotomie sur les echeances reellement arrondies, non deduit du taux nominal.",
        "operationId": "echeancier",
        "parameters": [
          {
            "name": "capital",
            "in": "query",
            "required": true,
            "description": "Montant emprunte, en unites monetaires, avec au plus deux decimales.",
            "schema": { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
            "example": "250000.00"
          },
          {
            "name": "taux",
            "in": "query",
            "required": true,
            "description": "Taux nominal annuel en pourcent, avec au plus six decimales. Le taux periodique en est deduit par division par douze (taux proportionnel).",
            "schema": { "type": "string", "pattern": "^\\d{1,2}(\\.\\d{1,6})?$" },
            "example": "3.45"
          },
          {
            "name": "mois",
            "in": "query",
            "required": true,
            "description": "Duree en mensualites.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 600 },
            "example": 240
          },
          {
            "name": "methode",
            "in": "query",
            "required": false,
            "description": "Methode d'amortissement. Les lettres A, C et I sont acceptees comme alias.",
            "schema": {
              "type": "string",
              "enum": ["annuite_constante", "capital_constant", "in_fine"],
              "default": "annuite_constante"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Echeancier calcule",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Reponse" }
              }
            }
          },
          "400": {
            "description": "Parametre absent ou hors bornes. Le champ fautif est nomme.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Erreur" },
                "example": {
                  "status": "error",
                  "champ": "mois",
                  "message": "doit etre compris entre 1 et 600"
                }
              }
            }
          },
          "401": {
            "description": "Cle d'API absente ou invalide",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } }
            }
          },
          "429": {
            "description": "Plafond de requetes par minute atteint",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } }
            }
          },
          "500": {
            "description": "Echec du moteur de calcul",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } }
            }
          },
          "504": {
            "description": "Le calcul a depasse son delai",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Erreur" } }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cleAPI": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Obligatoire en production ; le serveur refuse de demarrer sans elle."
      }
    },
    "schemas": {
      "Sante": {
        "type": "object",
        "required": ["status", "timestamp", "programExists"],
        "properties": {
          "status": { "type": "string", "enum": ["OK", "ERROR"] },
          "timestamp": { "type": "string", "format": "date-time" },
          "programExists": { "type": "boolean" }
        }
      },
      "Erreur": {
        "type": "object",
        "required": ["status", "message"],
        "properties": {
          "status": { "type": "string", "const": "error" },
          "message": { "type": "string" },
          "champ": {
            "type": "string",
            "description": "Present sur les 400 : nomme le parametre fautif."
          }
        }
      },
      "Demande": {
        "type": "object",
        "description": "Les parametres tels que le service les a compris, apres normalisation.",
        "required": ["capital", "taux", "mois", "methode"],
        "properties": {
          "capital": { "type": "string", "example": "250000.00" },
          "taux": { "type": "string", "example": "3.450000" },
          "mois": { "type": "integer", "example": 240 },
          "methode": {
            "type": "string",
            "enum": ["annuite_constante", "capital_constant", "in_fine"]
          }
        }
      },
      "Recapitulatif": {
        "type": "object",
        "required": [
          "echeances",
          "premiere_echeance",
          "derniere_echeance",
          "total_interets",
          "total_du",
          "taeg"
        ],
        "properties": {
          "echeances": { "type": "integer", "example": 240 },
          "premiere_echeance": {
            "type": "number",
            "description": "Sous annuite_constante, toutes les echeances sauf la derniere valent ce montant.",
            "example": 1443.48
          },
          "derniere_echeance": {
            "type": "number",
            "description": "Absorbe le residu d'arrondi accumule sur les periodes precedentes.",
            "example": 1444.93
          },
          "total_interets": { "type": "number", "example": 96436.65 },
          "total_du": { "type": "number", "example": 346436.65 },
          "taeg": {
            "type": "number",
            "description": "Taux annuel effectif global en pourcent, a quatre decimales, resolu par dichotomie sur les flux reels.",
            "example": 3.5051
          }
        }
      },
      "Echeance": {
        "type": "object",
        "required": ["n", "paiement", "interets", "capital", "solde"],
        "properties": {
          "n": { "type": "integer", "minimum": 1, "example": 1 },
          "paiement": { "type": "number", "example": 1443.48 },
          "interets": { "type": "number", "example": 718.75 },
          "capital": { "type": "number", "example": 724.73 },
          "solde": {
            "type": "number",
            "description": "Capital restant du apres cette echeance. Nul apres la derniere.",
            "example": 249275.27
          }
        }
      },
      "Reponse": {
        "type": "object",
        "required": ["status", "demande", "recapitulatif", "echeancier"],
        "properties": {
          "status": { "type": "string", "const": "success" },
          "demande": { "$ref": "#/components/schemas/Demande" },
          "recapitulatif": { "$ref": "#/components/schemas/Recapitulatif" },
          "echeancier": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Echeance" }
          }
        }
      }
    }
  }
}
