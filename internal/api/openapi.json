{
  "openapi": "3.1.0",
  "info": {
    "title": "cobol-api",
    "version": "1.0.0",
    "description": "Moteur d'amortissement de pret ecrit en COBOL, expose en REST, pour le marche tunisien.\n\nLes montants sont en dinars, exprimes au millime : le dinar se divise en mille. Ils sont rendus comme des nombres JSON a trois decimales exactes, produits par une arithmetique decimale a virgule fixe, et ne transitent jamais par un flottant binaire.\n\nSix invariants sont tenus : la somme des parts de capital egale exactement le capital emprunte, la somme des echeances egale exactement capital plus interets, le solde apres la derniere echeance est exactement nul, chaque ligne verifie echeance = capital + interets, chaque ligne verifie mensualite = echeance + assurance, et le total verse egale la somme des mensualites. La derniere echeance absorbe le residu d'arrondi.\n\nLe TEG est calcule selon le decret n° 2000-462 du 21 fevrier 2000 : le taux de periode est resolu par methode actuarielle sur l'ensemble des versements dus, interets, frais, commissions et assurance compris, puis annualise de facon proportionnelle et exprime avec deux decimales. Sans frais ni assurance, il egale le taux nominal.\n\nLe verdict de taux excessif applique la loi n° 99-64 du 15 juillet 1999 : est excessif tout pret dont le TEG excede de plus du cinquieme le taux effectif moyen publie pour la categorie de concours.",
    "license": {
      "name": "Proprietaire"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Developpement local"
    }
  ],
  "tags": [
    {
      "name": "credit",
      "description": "Calculs de credit"
    },
    {
      "name": "service",
      "description": "Etat et description du service"
    }
  ],
  "security": [
    {
      "cleAPI": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Index du service",
        "security": [],
        "responses": {
          "200": {
            "description": "Description du service et liste des endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Etat du service",
        "description": "Verifie la presence du binaire COBOL. Le HEALTHCHECK du conteneur s'appuie sur cet endpoint, qui reste ouvert et hors plafond de debit.",
        "security": [],
        "responses": {
          "200": {
            "description": "Service operationnel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                },
                "example": {
                  "status": "OK",
                  "timestamp": "2026-09-08T21:38:38Z",
                  "programExists": true
                }
              }
            }
          },
          "503": {
            "description": "Binaire COBOL introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Sante"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "service"
        ],
        "summary": "Cette specification",
        "security": [],
        "responses": {
          "200": {
            "description": "Document OpenAPI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/loans/schedule": {
      "get": {
        "tags": [
          "credit"
        ],
        "summary": "Echeancier de pret",
        "description": "Produit l'echeancier complet et son recapitulatif, TAEG compris. Le TAEG est resolu par dichotomie sur les echeances reellement arrondies, non deduit du taux nominal.",
        "operationId": "echeancier",
        "parameters": [
          {
            "name": "capital",
            "in": "query",
            "required": true,
            "description": "Montant emprunte en dinars, avec au plus trois decimales (millimes).",
            "schema": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,3})?$"
            },
            "example": "250000.000"
          },
          {
            "name": "taux",
            "in": "query",
            "required": true,
            "description": "Taux nominal annuel en pourcent, avec au plus six decimales. Le taux periodique en est deduit par division par douze (taux proportionnel).",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,2}(\\.\\d{1,6})?$"
            },
            "example": "8.5"
          },
          {
            "name": "mois",
            "in": "query",
            "required": true,
            "description": "Duree en mensualites.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 600
            },
            "example": 240
          },
          {
            "name": "methode",
            "in": "query",
            "required": false,
            "description": "Methode d'amortissement. Les lettres A, C et I sont acceptees comme alias.",
            "schema": {
              "type": "string",
              "enum": [
                "annuite_constante",
                "capital_constant",
                "in_fine"
              ],
              "default": "annuite_constante"
            }
          },
          {
            "name": "frais_dossier",
            "in": "query",
            "required": false,
            "description": "Frais de dossier, verses au depart. Ils diminuent ce que l'emprunteur percoit sans reduire ce qu'il rembourse, et font donc monter le TAEG.",
            "schema": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,3})?$",
              "default": "0"
            },
            "example": "1500.000"
          },
          {
            "name": "frais_garantie",
            "in": "query",
            "required": false,
            "description": "Frais de garantie, verses au depart. Meme traitement que les frais de dossier.",
            "schema": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d{1,3})?$",
              "default": "0"
            }
          },
          {
            "name": "taux_assurance",
            "in": "query",
            "required": false,
            "description": "Taux annuel d'assurance emprunteur en pourcent. La prime mensuelle en est deduite par division par douze.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,2}(\\.\\d{1,6})?$",
              "default": "0"
            },
            "example": "0.36"
          },
          {
            "name": "assiette_assurance",
            "in": "query",
            "required": false,
            "description": "Assiette de la prime. Un taux d'assurance sans assiette declaree porte sur le capital initial, convention la plus repandue. Les lettres N, I et R sont acceptees comme alias.",
            "schema": {
              "type": "string",
              "enum": [
                "aucune",
                "capital_initial",
                "capital_restant_du"
              ],
              "default": "aucune"
            }
          },
          {
            "name": "tem",
            "in": "query",
            "required": false,
            "description": "Taux effectif moyen publie par la Banque Centrale de Tunisie pour la categorie de concours, en pourcent. Fourni, la reponse porte un verdict de taux excessif : le seuil est le TEM majore d'un cinquieme, et le depassement est strict. Omis, le TEG est rendu sans jugement. S'exclut avec categorie.",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,2}(\\.\\d{1,2})?$"
            },
            "example": "10.25"
          },
          {
            "name": "categorie",
            "in": "query",
            "required": false,
            "description": "Categorie de concours. Le taux effectif moyen est alors lu dans le bareme en vigueur et la reponse cite l'arrete applique. S'exclut avec tem : la categorie determine le taux.",
            "schema": {
              "type": "string",
              "enum": [
                "leasing",
                "decouverts",
                "gestion_des_dettes",
                "credits_consommation",
                "credits_logement",
                "credits_moyen_terme",
                "credits_long_terme",
                "credits_court_terme"
              ]
            },
            "example": "credits_consommation"
          }
        ],
        "responses": {
          "200": {
            "description": "Echeancier calcule",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reponse"
                }
              }
            }
          },
          "400": {
            "description": "Parametre absent ou hors bornes. Le champ fautif est nomme.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                },
                "example": {
                  "status": "error",
                  "champ": "mois",
                  "message": "doit etre compris entre 1 et 600"
                }
              }
            }
          },
          "401": {
            "description": "Cle d'API absente ou invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          },
          "429": {
            "description": "Plafond de requetes par minute atteint",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          },
          "500": {
            "description": "Echec du moteur de calcul",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          },
          "504": {
            "description": "Le calcul a depasse son delai",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          }
        }
      }
    },
    "/v1/baremes": {
      "get": {
        "tags": [
          "credit"
        ],
        "summary": "Bareme en vigueur",
        "description": "Taux effectifs moyens en vigueur, une ligne par categorie de concours. Le seuil du taux excessif n'y figure pas : il se deduit du taux effectif moyen par la regle du cinquieme, portee par le moteur de calcul.",
        "operationId": "bareme",
        "responses": {
          "200": {
            "description": "Bareme en vigueur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "count",
                    "baremes"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "success"
                    },
                    "count": {
                      "type": "integer",
                      "example": 8
                    },
                    "baremes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Bareme"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Cle d'API absente ou invalide",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          },
          "503": {
            "description": "Bareme indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erreur"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cleAPI": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Obligatoire en production ; le serveur refuse de demarrer sans elle."
      }
    },
    "schemas": {
      "Sante": {
        "type": "object",
        "required": [
          "status",
          "timestamp",
          "programExists"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "OK",
              "ERROR"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "programExists": {
            "type": "boolean"
          }
        }
      },
      "Erreur": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "error"
          },
          "message": {
            "type": "string"
          },
          "champ": {
            "type": "string",
            "description": "Present sur les 400 : nomme le parametre fautif."
          }
        }
      },
      "Demande": {
        "type": "object",
        "description": "Les parametres tels que le service les a compris, apres normalisation.",
        "required": [
          "capital",
          "taux",
          "mois",
          "methode",
          "frais_dossier",
          "frais_garantie",
          "taux_assurance",
          "assiette_assurance"
        ],
        "properties": {
          "capital": {
            "type": "string",
            "example": "250000.000"
          },
          "taux": {
            "type": "string",
            "example": "8.500000"
          },
          "mois": {
            "type": "integer",
            "example": 240
          },
          "methode": {
            "type": "string",
            "enum": [
              "annuite_constante",
              "capital_constant",
              "in_fine"
            ]
          },
          "frais_dossier": {
            "type": "string",
            "example": "1500.000"
          },
          "frais_garantie": {
            "type": "string",
            "example": "900.000"
          },
          "taux_assurance": {
            "type": "string",
            "example": "0.360000"
          },
          "assiette_assurance": {
            "type": "string",
            "enum": [
              "aucune",
              "capital_initial",
              "capital_restant_du"
            ]
          },
          "tem": {
            "type": "string",
            "description": "Absent quand aucune verification n'est demandee.",
            "example": "10.25"
          }
        }
      },
      "Recapitulatif": {
        "type": "object",
        "required": [
          "echeances",
          "premiere_mensualite",
          "derniere_mensualite",
          "total_interets",
          "total_assurance",
          "total_frais",
          "total_verse",
          "cout_credit",
          "teg",
          "tem",
          "seuil_excessif",
          "conforme",
          "marge"
        ],
        "properties": {
          "echeances": {
            "type": "integer",
            "example": 240
          },
          "premiere_mensualite": {
            "type": "number",
            "description": "Sous annuite_constante et sans assurance sur le capital restant du, toutes les mensualites sauf la derniere valent ce montant.",
            "example": 2169.558
          },
          "derniere_mensualite": {
            "type": "number",
            "description": "Absorbe le residu d'arrondi accumule sur les periodes precedentes.",
            "example": 2169.614
          },
          "total_interets": {
            "type": "number",
            "example": 270693.976
          },
          "total_assurance": {
            "type": "number",
            "example": 0.0
          },
          "total_frais": {
            "type": "number",
            "description": "Somme des frais de dossier et de garantie, verses au depart.",
            "example": 0.0
          },
          "total_verse": {
            "type": "number",
            "description": "Somme des mensualites, frais initiaux exclus.",
            "example": 520693.976
          },
          "cout_credit": {
            "type": "number",
            "description": "Interets, assurance et frais reunis.",
            "example": 270693.976
          },
          "conforme": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Faux si le TEG excede le seuil, auquel cas le pret est usuraire au sens de la loi n° 99-64. Un TEG egal au seuil reste licite.",
            "example": true
          },
          "teg": {
            "type": "number",
            "description": "Taux effectif global en pourcent, deux decimales, selon le decret n° 2000-462. Annualisation proportionnelle du taux de periode.",
            "example": 8.5
          },
          "tem": {
            "type": [
              "number",
              "null"
            ],
            "description": "Taux effectif moyen applique. Nul quand aucune verification n'a ete demandee.",
            "example": 10.25
          },
          "seuil_excessif": {
            "type": [
              "number",
              "null"
            ],
            "description": "Seuil du taux excessif : le TEM majore d'un cinquieme, arrondi a deux decimales. Nul quand aucune verification n'a ete demandee.",
            "example": 12.3
          },
          "marge": {
            "type": [
              "number",
              "null"
            ],
            "description": "Seuil moins TEG, en points de pourcentage. Negatif si le pret est excessif.",
            "example": 3.8
          }
        }
      },
      "Echeance": {
        "type": "object",
        "required": [
          "n",
          "echeance",
          "interets",
          "capital",
          "assurance",
          "mensualite",
          "solde"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "echeance": {
            "type": "number",
            "description": "Part de credit : capital + interets.",
            "example": 2169.558
          },
          "interets": {
            "type": "number",
            "example": 1770.833
          },
          "capital": {
            "type": "number",
            "example": 398.725
          },
          "assurance": {
            "type": "number",
            "example": 0.0
          },
          "mensualite": {
            "type": "number",
            "description": "Ce que l'emprunteur verse : echeance + assurance.",
            "example": 2169.558
          },
          "solde": {
            "type": "number",
            "description": "Capital restant du apres cette echeance. Nul apres la derniere.",
            "example": 249601.275
          }
        }
      },
      "Reponse": {
        "type": "object",
        "required": [
          "status",
          "demande",
          "recapitulatif",
          "echeancier"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "success"
          },
          "demande": {
            "$ref": "#/components/schemas/Demande"
          },
          "recapitulatif": {
            "$ref": "#/components/schemas/Recapitulatif"
          },
          "echeancier": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Echeance"
            }
          },
          "bareme": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Bareme"
              }
            ],
            "description": "Present seulement quand une categorie a ete fournie."
          }
        }
      },
      "Bareme": {
        "type": "object",
        "description": "Taux effectif moyen applique, tel que publie par arrete.",
        "required": [
          "categorie",
          "semestre",
          "tem",
          "arrete",
          "publie_le"
        ],
        "properties": {
          "categorie": {
            "type": "string",
            "example": "credits_consommation"
          },
          "semestre": {
            "type": "string",
            "description": "Semestre d'application, forme 2026S1.",
            "example": "2026S1"
          },
          "tem": {
            "type": "string",
            "description": "Rendu en chaine : la valeur ne passe jamais par un flottant.",
            "example": "11.23"
          },
          "arrete": {
            "type": "string",
            "example": "Arrete du 28 juillet 2026"
          },
          "publie_le": {
            "type": "string",
            "format": "date",
            "example": "2026-07-28"
          }
        }
      }
    }
  }
}
