# .dockerignore

# Ignore Node.js dependencies
**/node_modules
npm-debug.log
npm-debug.log.*

# Version control
.git
.gitignore

# Operating system files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Environment and sensitive files
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build and compiled outputs
dist
build
*.log

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~

# Miscellaneous
.tmp
.cache