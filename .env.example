# Copier en .env puis renseigner.
#
# Cle attendue dans l'en-tete X-API-Key sur les endpoints proteges.
# En generer une avec : openssl rand -hex 32
API_KEY=

# Mot de passe de la base. En generer un avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# Facultatifs.
POSTGRES_DB=cobol_api
POSTGRES_USER=cobol_api

# Requetes par minute et par adresse IP sur les endpoints proteges.
RATE_LIMIT_PER_MINUTE=30

# Origines autorisees pour les appels navigateur, separees par des virgules.
# Le frontend etant servi depuis une autre origine que l'API, celle-ci doit y
# figurer, sans quoi le navigateur refusera les reponses.
CORS_ORIGINS=http://localhost:8080

# Port par lequel le frontend est publie.
WEB_PORT=8080

# Adresse par laquelle le NAVIGATEUR joint l'API — non celle du reseau interne
# de Compose. Elle est figee au build de l'image du frontend : Vite substitue
# import.meta.env a la compilation, elle ne se lit pas au demarrage. La changer
# demande de rebatir l'image du service web.
VITE_API_URL=http://localhost:3000
