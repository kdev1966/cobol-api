# Copier en .env puis renseigner.
#
# Cle attendue dans l'en-tete X-API-Key sur les endpoints proteges.
# En generer une avec : openssl rand -hex 32
API_KEY=

# Mot de passe de la base. En generer un avec : openssl rand -hex 24
POSTGRES_PASSWORD=

# Facultatifs.
POSTGRES_DB=cobol_api
POSTGRES_USER=cobol_api

# Requetes par minute et par adresse IP sur les endpoints proteges.
RATE_LIMIT_PER_MINUTE=30

# Origines autorisees pour les appels navigateur, separees par des virgules.
# Vide = aucune origine croisee autorisee.
CORS_ORIGINS=
